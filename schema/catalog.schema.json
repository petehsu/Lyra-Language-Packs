{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "packs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "locale", "nativeName", "englishName", "aliases", "version",
          "minAppVersion", "sourceContentHash", "keysetHash", "sha256",
          "asset", "signature"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
